; Dawn of Dynasties, Godot edition. Engine configuration file.
config_version=5

[application]

config/name="Dawn of Dynasties"
config/version="0.7"
config/icon="res://assets/ui/app_icon_512.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.02, 0.02, 1)
boot_splash/image="res://assets/ui/studio_logo.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

D="*res://sim/d.gd"
M="*res://sim/m.gd"
G="*res://sim/g.gd"
E="*res://sim/e.gd"
Maps="*res://sim/maps.gd"
AI="*res://sim/ai.gd"
Modes="*res://sim/modes.gd"
Specials="*res://sim/specials.gd"
Art="*res://view/art.gd"
Save="*res://sim/save.gd"
Sfx="*res://view/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
